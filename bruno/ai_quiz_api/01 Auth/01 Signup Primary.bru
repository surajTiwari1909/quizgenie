meta {
  name: Signup Primary
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("accessToken", res.body.tokens.access);
    bru.setEnvVar("refreshToken", res.body.tokens.refresh);
  }
}

docs {
  Creates the primary/host account and stores its JWT tokens. If the account already
  exists, use Signin Primary.
}

meta {
  name: Signin Primary
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/signin
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.tokens.access);
    bru.setEnvVar("refreshToken", res.body.tokens.refresh);
  }
}

assert {
  res.status: eq 200
}

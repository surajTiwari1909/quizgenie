meta {
  name: Retake Solo Attempt
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/games/solo/{{attemptId}}/retake
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("attemptId", res.body.id);
    if (res.body.questions && res.body.questions.length > 0) {
      bru.setEnvVar("questionId", res.body.questions[0].id);
      bru.setEnvVar("answerOptionId", res.body.questions[0].answer_options[0].id);
    }
  }
}

assert {
  res.status: eq 201
}

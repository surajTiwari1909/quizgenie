APP_NAME=AI Quiz Game API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=quiz_game
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=quiz_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5434/quiz_game
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379
CACHE_URL=redis://localhost:6379/1

GROQ_API_KEY=
GROQ_QUIZ_MODEL=openai/gpt-oss-120b
QUIZ_GENERATOR_CLASS=quizzes.providers.GroqQuestionGenerator
QUIZ_MAX_REGENERATION_ATTEMPTS=2
QUIZ_GENERATION_REQUEST_TIMEOUT=60
QUIZ_GENERATION_SOFT_TIME_LIMIT=150
QUIZ_GENERATION_TIME_LIMIT=180
SOLO_ATTEMPT_TIME_LIMIT_SECONDS=1800

USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4

DOCUMENT_MAX_COUNT_PER_USER=20
DOCUMENT_MAX_FILE_SIZE=10485760
DOCUMENT_MAX_PAGE_COUNT=250
DOCUMENT_MAX_EXTRACTED_CHARACTERS=1000000
DOCUMENT_MAX_TOTAL_BYTES_PER_USER=104857600
DOCUMENT_RETENTION_DAYS=30
DOCUMENT_PROCESSING_SOFT_TIME_LIMIT=60
DOCUMENT_PROCESSING_TIME_LIMIT=75
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15

PGADMIN_DEFAULT_EMAIL=admin@quiz.local
PGADMIN_DEFAULT_PASSWORD=admin_password
PGADMIN_PORT=5050

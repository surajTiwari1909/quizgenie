APP_NAME=AI Quiz Game API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=quiz_game
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=quiz_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5434/quiz_game

PGADMIN_DEFAULT_EMAIL=admin@quiz.local
PGADMIN_DEFAULT_PASSWORD=admin_password
PGADMIN_PORT=5050
